{
  "should_block": [
    "cat .env",
    "head -n 5 apps/api/.env.local",
    "grep DATABASE_URL .env.production",
    "less ~/.aws/credentials",
    "cat ~/.ssh/id_ed25519",
    "git show HEAD~3:.env",
    "bash -c 'cat .env | base64'",
    "cp .env /tmp/env-copy",
    "awk -F= '{print $1}' < .env",
    "sudo cat /etc/app/server.key",
    "cat ~/.npmrc",
    "rg -n SECRET .env.staging",
    "echo $GITHUB_TOKEN",
    "printf '%s' \"${STRIPE_SECRET_KEY}\"",
    "printenv AWS_SECRET_ACCESS_KEY",
    "env",
    "env | grep -i aws",
    "export -p",
    "kubectl get secret db-creds -o yaml",
    "kubectl get secrets api -o jsonpath='{.data.password}'",
    "docker inspect web-1",
    "docker inspect --format '{{json .Config.Env}}' web-1"
  ],
  "should_allow": [
    "cat .env.example",
    "cp .env.example .env",
    "ls -la .env",
    "git check-ignore -q .env",
    "source .env && npm run migrate",
    "docker run --env-file .env myimage",
    "dotenv -e .env -- npm test",
    "rm .env.local",
    "cat ~/.ssh/id_ed25519.pub",
    "grep -r process.env src/",
    "echo 'remember to set .env' > notes.md",
    "git ls-files .env",
    "echo $HOME",
    "printenv PATH",
    "env NODE_ENV=test npm test",
    "curl -H \"Authorization: Bearer $GITHUB_TOKEN\" https://api.github.com/user",
    "kubectl get secrets",
    "kubectl describe secret db-creds",
    "docker inspect --format '{{.State.Status}}' web-1",
    "echo \"set the API key in .env.example\""
  ]
}
