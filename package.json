{
  "name": "@ketecode/loom",
  "version": "0.1.0",
  "description": "Kete Loom: curated, tested, portable Agent Skills, subagents, commands, rules, hooks and MCP configs. One source, installable in Claude Code, Codex, OpenCode, Cursor, Gemini CLI, GitHub Copilot, Kete Code and Kiro.",
  "license": "MIT",
  "author": "Kete-org <support@ketecode.ai>",
  "homepage": "https://ketecode.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kete-org/kete-loom.git"
  },
  "bugs": "https://github.com/kete-org/kete-loom/issues",
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "gemini-cli",
    "copilot",
    "kete-code",
    "kiro"
  ],
  "bin": {
    "kete-loom": "bin/kete-loom.js"
  },
  "files": [
    "bin/",
    "scripts/lib/",
    "skills/",
    "agents/",
    "commands/",
    "hooks/",
    "rules/",
    "mcp/",
    "profiles.json",
    "schemas/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node scripts/lint-skills.js",
    "eval": "node scripts/run-evals.js",
    "eval:estimate": "node scripts/run-evals.js --estimate",
    "eval:live": "node scripts/run-evals.js --live",
    "test": "node --test",
    "check": "npm run lint && npm test && npm run eval",
    "catalog": "node scripts/build-catalog.js",
    "site": "node scripts/build-site.js",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  }
}
